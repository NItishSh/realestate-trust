{
  "title": "Postgres Health",
  "uid": "postgres-health",
  "tags": ["realestate-trust", "postgres"],
  "timezone": "browser",
  "schemaVersion": 30,
  "panels": [
    {
      "title": "Active Connections",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{state=\"active\"})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Slow Queries (> 200ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(pg_stat_statements_calls{time_seconds_sum>\".2\"}[5m])",
          "refId": "A"
        }
      ]
    }
  ]
}
